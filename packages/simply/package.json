{
  "name": "@simplysf/simply",
  "description": "Salesforce CLI Plugins created by @SimplySF",
  "version": "2.22.1",
  "author": "@ClayChipps",
  "homepage": "https://github.com/SimplySF/simply-node",
  "bugs": "https://github.com/SimplySF/simply-node/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/SimplySF/simply-node",
    "directory": "packages/simply"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "/lib",
    "/messages",
    "/oclif.lock",
    "/oclif.manifest.json"
  ],
  "keywords": [
    "oclif",
    "salesforce",
    "sf",
    "simply"
  ],
  "license": "Apache-2.0",
  "exports": "./lib/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "oclif": {
    "additionalVersionFlags": [
      "-v"
    ],
    "additionalHelpFlags": [
      "-h"
    ],
    "bin": "sf",
    "binAliases": [
      "sfdx"
    ],
    "commands": "lib/commands",
    "devPlugins": [
      "@oclif/plugin-command-snapshot"
    ],
    "exitCodes": {
      "default": 1,
      "failedFlagParsing": 2,
      "failedFlagValidation": 2,
      "invalidArgsSpec": 2,
      "nonExistentFlag": 2,
      "requiredArgs": 2,
      "unexpectedArgs": 2
    },
    "flexibleTaxonomy": true,
    "plugins": [
      "@simplysf/simply-aep",
      "@simplysf/simply-apex",
      "@simplysf/simply-community",
      "@simplysf/simply-data",
      "@simplysf/simply-document",
      "@simplysf/simply-package",
      "@simplysf/simply-permissions",
      "@simplysf/simply-project",
      "@simplysf/simply-schema",
      "@simplysf/simply-sobject"
    ],
    "repositoryPrefix": "<%- repo %>/blob/@simplysf/simply@<%- version %>/packages/simply/<%- commandPath %>",
    "topicSeparator": " ",
    "warn-if-update-available": {
      "timeoutInDays": 7
    }
  },
  "dependencies": {
    "@oclif/core": "^4.11.2",
    "@simplysf/simply-aep": "workspace:^0.3.1",
    "@simplysf/simply-apex": "workspace:^1.6.5",
    "@simplysf/simply-community": "workspace:^0.6.1",
    "@simplysf/simply-data": "workspace:^2.4.0",
    "@simplysf/simply-document": "workspace:^0.3.6",
    "@simplysf/simply-package": "workspace:^2.10.1",
    "@simplysf/simply-permissions": "workspace:^1.2.31",
    "@simplysf/simply-project": "workspace:^1.2.17",
    "@simplysf/simply-schema": "workspace:^0.3.17",
    "@simplysf/simply-sobject": "workspace:^1.6.5",
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@oclif/plugin-command-snapshot": "^5.3.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "wireit",
    "compile": "wireit",
    "fix-license": "eslint src test --fix --rule \"header/header: [2]\"",
    "format": "wireit",
    "link-check": "wireit",
    "lint": "wireit",
    "oclif-artifacts": "oclif manifest",
    "prepare": "pnpm run compile && pnpm run lint",
    "promote": "oclif promote",
    "readme": "oclif readme --no-aliases"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "command-snapshot",
        "compile",
        "lint"
      ]
    },
    "command-snapshot": {
      "command": "node --loader ts-node/esm --no-warnings=ExperimentalWarning \"./bin/dev.js\" snapshot:generate && prettier --write command-snapshot.json",
      "files": [
        "src/**/*.ts"
      ],
      "output": [
        "command-snapshot.json"
      ],
      "dependencies": [
        "compile",
        "../simply-aep:compile",
        "../simply-apex:compile",
        "../simply-community:compile",
        "../simply-data:compile",
        "../simply-document:compile",
        "../simply-package:compile",
        "../simply-permissions:compile",
        "../simply-project:compile",
        "../simply-schema:compile",
        "../simply-sobject:compile"
      ]
    },
    "compile": {
      "command": "tsc -p . --pretty --incremental",
      "files": [
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json",
        "messages/**"
      ],
      "output": [
        "lib/**",
        "*.tsbuildinfo"
      ],
      "clean": "if-file-deleted"
    },
    "format": {
      "command": "prettier --write \"+(src|test|schemas)/**/*.+(ts|js|json)|command-snapshot.json\"",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "schemas/**/*.json",
        "command-snapshot.json",
        ".prettier*"
      ],
      "output": []
    },
    "lint": {
      "command": "eslint src --color --cache --cache-location .eslintcache",
      "files": [
        "src/**/*.ts",
        "messages/**",
        "**/.eslint*",
        "**/tsconfig.json",
        "../../eslint.config.mjs",
        "../../tsconfig.json"
      ],
      "output": []
    },
    "link-check": {
      "command": "node -e \"process.exit(process.env.CI ? 0 : 1)\" || linkinator \"**/*.md\" --skip \"CHANGELOG.md|node_modules|test/|confluence.internal.salesforce.com|my.salesforce.com|localhost|example\\.(com|org|net)|github\\.com/SimplySF/simply-node|raw\\.githubusercontent\\.com/SimplySF/simply-node|blob/.*/lib/|%s\" --markdown --retry --directory-listing --verbosity error",
      "files": [
        "./*.md",
        "./!(CHANGELOG).md",
        "messages/**/*.md"
      ],
      "output": []
    }
  }
}
